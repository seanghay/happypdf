  "repository": "git+https://github.com/seanghay/happypdf.git",
  "files": [
    "dist/",
    "src/",
    "LICENSE.md",
    "package.json",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "unpkg": "./dist/happypdf.min.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "scripts": {
    "release": "npm run release:prep && release-it",
    "release:prep": "npm run clean && npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "get:version": "node --eval 'console.log(require(`./package.json`).version)'",
    "clean": "rimraf dist build coverage tsBuildInfo.json isolate*.log flamegraph.html out.pdf",
    "typecheck": "tsc --noEmit --incremental false --tsBuildInfoFile null",
    "build": "tsdown",
    "test": "vitest run",
    "testw": "vitest",
    "testc": "vitest run --coverage && open coverage/index.html",
    "test:visual:update": "VISUAL_UPDATE=1 vitest run tests/visual/visual.spec.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt .",
    "format:check": "oxfmt --check ."
  },
  "dependencies": {
    "@pdf-lib/standard-fonts": "^1.0.0",
    "@pdf-lib/upng": "^1.0.1",
    "color": "^4.2.3",
    "crypto-js": "^4.2.0",
    "harfbuzzjs": "0.10.3",
    "html-entities": "^2.3.2",
    "node-html-better-parser": ">=1.5.9",
    "pako": "^2.2.0",
    "tslib": ">=2"
  },
  "devDependencies": {
    "@types/color": "^3.0.1",
    "@types/crypto-js": "^4.2.2",
    "@types/pako": "^2.0.4",
    "oxfmt": "^0.63.0",
    "oxlint": "^1.78.0",
    "release-it": "^17.0.3",
    "rimraf": "^5.0.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "html-entities": "^2.3.2"
  },
  "resolutions": {
    "pako": "^2.2.0"
  },
  "overrides": {
    "pako": "^2.2.0"
  },
  "engines": {
    "node": ">=22"
  }
}
