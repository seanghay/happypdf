{
  "name": "happypdf",
  "version": "0.1.0",
  "private": false,
  "description": "Create and modify PDF files with JavaScript, with HarfBuzz shaping for complex scripts",
  "keywords": [
    "arabic",
    "complex-scripts",
    "create",
    "document",
    "edit",
    "happypdf",
    "harfbuzz",
    "indic",
    "javascript",
    "khmer",
    "modify",
    "pdf",
    "shaping",
    "typescript"
  ],
  "homepage": "https://github.com/seanghay/happypdf",
  "bugs": {
    "url": "https://github.com/seanghay/happypdf/issues"
  },
  "license": "MIT",
  "author": "Seanghay Yath",
  "contributors": [
    "Andrew Dillon <andrew.dillon.j@gmail.com> (original pdf-lib author)",
